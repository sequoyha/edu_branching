        "style": "solid"
      },
      {
        "from": "oplog",
        "to": "secondaryB",
        "style": "solid"
      },
      {
        "from": "primary",
        "to": "majority",
        "style": "dashed"
      },
      {
        "from": "secondaryA",
        "to": "election",
        "style": "dashed"
      },
      {
        "from": "secondaryB",
        "to": "election",
        "style": "dashed"
      },
      {
        "from": "election",
        "to": "application",
        "style": "dashed"
      }
    ],
    "notes": [
      {
        "text": "Pro Tip: Place the 3 voting members across 3 availability zones so losing one zone still leaves a 2-vote majority. Replication is not a backup; retain independent backups.",
        "emoji": "💡"
      },
      {
        "text": "Solid connections show the main write and replication paths; dashed connections show acknowledgment and failover relationships. Secondaries can also replicate from other eligible members.",
        "emoji": "🔎"
      },
      {
        "text": "Monitor replication lag and oplog retention. If a secondary falls behind beyond retained history, it may need a full initial sync.",
        "emoji": "📊"
      }
    ]
  },
