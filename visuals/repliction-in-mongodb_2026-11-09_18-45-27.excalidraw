  "graph": {
    "title": "MongoDB Replica Set Architecture",
    "titleEmoji": "🍃",
    "direction": "TB",
    "nodes": [
      {
        "id": "application",
        "type": "component",
        "label": "Application and Driver",
        "emoji": "🖥️",
        "description": "Connect using a replica-set URI with multiple seed hosts. The driver discovers members and routes writes to the current primary.",
        "semanticColor": "primary",
        "row": 0,
        "column": 1
      },
      {
        "id": "primary",
        "type": "component",
        "label": "Primary",
        "emoji": "👑",
        "description": "One primary accepts writes in this 3-member replica set. Reads also target the primary unless another read preference is configured.",
        "semanticColor": "warning",
        "row": 1,
        "column": 1
      },
      {
        "id": "oplog",
        "type": "component",
        "label": "Primary Oplog",
        "emoji": "📜",
        "description": "The primary records data changes in local.oplog.rs, a capped collection. Secondaries asynchronously fetch entries and apply them in order.",
        "semanticColor": "secondary",
        "row": 2,
        "column": 1
      },
      {
        "id": "secondaryA",
        "type": "component",
        "label": "Secondary A",
        "emoji": "📚",
        "description": "Data-bearing voting member with its own oplog. Replicates changes, can serve explicitly configured secondary reads, and can become primary if eligible.",
        "semanticColor": "info",
        "row": 3,
        "column": 0
      },
      {
        "id": "secondaryB",
        "type": "component",
        "label": "Secondary B",
        "emoji": "🗄️",
        "description": "Third data-bearing voting member. Maintains another copy; replication lag means secondary reads can return older data.",
        "semanticColor": "success",
        "row": 3,
        "column": 2
      },
      {
        "id": "majority",
        "type": "component",
        "label": "Majority Write Acknowledgment",
        "emoji": "✅",
        "description": "With w: 'majority', writes require majority commitment: 2 of these 3 voting data-bearing members. Acknowledgment does not require every secondary to catch up.",
        "semanticColor": "primary",
        "row": 4,
        "column": 0
      },
      {
        "id": "election",
        "type": "component",
        "label": "Automatic Failover",
        "emoji": "🗳️",
        "description": "Members exchange heartbeats. If the primary becomes unavailable, an eligible secondary needs 2 of 3 votes to become primary. Writes pause until a primary is available.",
        "semanticColor": "danger",
        "row": 4,
        "column": 2
      }
    ],
    "connections": [
      {
        "from": "application",
        "to": "primary",
        "style": "solid"
      },
      {
        "from": "primary",
        "to": "oplog",
